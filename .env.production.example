# ==========================================
# CONFIGURACIÓN DE PRODUCCIÓN
# Sistema de Validación de Informes v2.0 - UNTELS
# ==========================================

# IMPORTANTE: 
# 1. Copiar este archivo a .env.production
# 2. Completar todas las variables OBLIGATORIAS
# 3. NO commitear .env.production al repositorio
# 4. Cambiar TODOS los valores de ejemplo por valores seguros

# ==========================================
# DJANGO
# ==========================================

# OBLIGATORIO: Generar con: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_50_CHARACTERS_MINIMUM

# OBLIGATORIO: Modo de ejecución (SIEMPRE False en producción)
DJANGO_DEBUG=False

# OBLIGATORIO: Dominios permitidos (separados por coma)
DJANGO_ALLOWED_HOSTS=untels.edu.pe,www.untels.edu.pe,localhost,127.0.0.1

# Módulo de settings a usar
DJANGO_SETTINGS_MODULE=config.settings.production

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================

# OBLIGATORIO: Nombre de la base de datos
DB_NAME=untels_validacion_informes

# OBLIGATORIO: Usuario de PostgreSQL
DB_USER=untels_user

# OBLIGATORIO: Contraseña de PostgreSQL (CAMBIAR)
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Host de la base de datos (usar 'db' para Docker)
DB_HOST=db

# Puerto de PostgreSQL
DB_PORT=5432

# ==========================================
# GROQ API (Validación con IA)
# ==========================================

# OBLIGATORIO: API Key de Groq
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# ==========================================
# EMAIL (Notificaciones)
# ==========================================

# Servidor SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# OBLIGATORIO: Credenciales de email
EMAIL_HOST_USER=sistema.validacion@untels.edu.pe
EMAIL_HOST_PASSWORD=CHANGE_THIS_TO_EMAIL_APP_PASSWORD

# Email desde el cual se envían notificaciones
DEFAULT_FROM_EMAIL=sistema.validacion@untels.edu.pe

# ==========================================
# REDIS (Caché - Opcional)
# ==========================================

# OBLIGATORIO si usas Redis: Contraseña de Redis
REDIS_PASSWORD=CHANGE_THIS_TO_REDIS_PASSWORD

# URL de conexión a Redis
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0

# ==========================================
# PUERTOS
# ==========================================

# Puerto HTTP (80 por defecto)
HTTP_PORT=80

# Puerto HTTPS (443 por defecto)
HTTPS_PORT=443

# ==========================================
# SEGURIDAD
# ==========================================

# Cookies seguras (True en producción con HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Redirect HTTP a HTTPS
SECURE_SSL_REDIRECT=True

# ==========================================
# DATOS DE PRUEBA
# ==========================================

# Poblar datos de prueba al iniciar (False en producción)
POPULATE_TEST_DATA=false

# ==========================================
# BACKUPS
# ==========================================

# Directorio para backups
BACKUP_DIR=/backups

# Días de retención de backups
BACKUP_RETENTION_DAYS=30

# ==========================================
# LOGGING
# ==========================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==========================================
# LÍMITES DE ARCHIVOS
# ==========================================

# Tamaño máximo de archivo de informe (en MB)
MAX_UPLOAD_SIZE=50

# Tamaño máximo de banco de observaciones (en MB)
MAX_BANCO_SIZE=10

# ==========================================
# TIMEZONE
# ==========================================

# Zona horaria
TZ=America/Lima

# ==========================================
# NOTAS IMPORTANTES
# ==========================================

# 1. SEGURIDAD:
#    - Cambiar TODAS las contraseñas y secretos
#    - No usar valores por defecto
#    - No commitear este archivo al repositorio

# 2. GROQ API:
#    - Crear cuenta en https://console.groq.com/
#    - Generar API key
#    - Agregar la key aquí

# 3. EMAIL:
#    - Para Gmail, crear "App Password" en:
#      https://myaccount.google.com/apppasswords
#    - No usar la contraseña principal de Gmail

# 4. HTTPS:
#    - Configurar certificados SSL en nginx/ssl/
#    - Usar Let's Encrypt para certificados gratuitos

# 5. BACKUPS:
#    - Configurar backups automáticos de PostgreSQL
#    - Guardar backups fuera del servidor

# 6. MONITORING:
#    - Configurar monitoreo del servidor
#    - Configurar alertas de errores
#    - Revisar logs regularmente

          <mxGeometry x="600" y="780" width="450" height="40" as="geometry"/>
        </mxCell>
        
        <mxCell id="leyenda-content" value="&lt;b&gt;Notaciones:&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; = Primary Key (Clave Primaria)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; = Foreign Key (Clave Foránea)&lt;br&gt;&lt;b&gt;UNIQUE&lt;/b&gt; = Valor único en la tabla&lt;br&gt;&lt;i&gt;Cursiva&lt;/i&gt; = Campos de auditoría (fechas)&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidades:&lt;/b&gt;&lt;br&gt;─── (1) = Uno&lt;br&gt;──&lt; (N) = Muchos&lt;br&gt;──o (0..1) = Cero o uno&lt;br&gt;&lt;br&gt;&lt;b&gt;Motor de BD:&lt;/b&gt;&lt;br&gt;• Desarrollo: SQLite 3&lt;br&gt;• Producción: PostgreSQL (recomendado)&lt;br&gt;&lt;br&gt;&lt;b&gt;Total de Tablas Principales: 6&lt;/b&gt;&lt;br&gt;1. Usuario&lt;br&gt;2. Escuela&lt;br&gt;3. Informe (núcleo)&lt;br&gt;4. ObservacionGenerada&lt;br&gt;5. BancoObservacionesDocente&lt;br&gt;6. Notificacion" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="830" width="430" height="200" as="geometry"/>
        </mxCell>
        
        <!-- ==================== ÍNDICES IMPORTANTES ==================== -->
        <mxCell id="indices-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1150" y="860" width="400" height="180" as="geometry"/>
        </mxCell>
        
        <mxCell id="indices-titulo" value="&lt;b&gt;⚡ ÍNDICES PARA OPTIMIZACIÓN&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#000000;fontColor=#ffffff;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1150" y="860" width="400" height="35" as="geometry"/>
        </mxCell>
        
        <mxCell id="indices-content" value="&lt;b&gt;Índices Compuestos:&lt;/b&gt;&lt;br&gt;&lt;br&gt;CREATE INDEX idx_informe_docente_estado&lt;br&gt;  ON informes_informe&lt;br&gt;  (docente_revisor_id, estado);&lt;br&gt;&lt;br&gt;CREATE INDEX idx_informe_presidente_estado&lt;br&gt;  ON informes_informe&lt;br&gt;  (presidente_asignado_id, estado);&lt;br&gt;&lt;br&gt;CREATE INDEX idx_informe_usuario_version&lt;br&gt;  ON informes_informe&lt;br&gt;  (usuario_id, version DESC);&lt;br&gt;&lt;br&gt;CREATE INDEX idx_notificacion_usuario_leida&lt;br&gt;  ON notificaciones_notificacion&lt;br&gt;  (usuario_id, leida);" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1160" y="905" width="380" height="125" as="geometry"/>
        </mxCell>
        
        <!-- NOTAS FINALES -->
        <mxCell id="notas-titulo" value="&lt;b&gt;📝 NOTAS IMPORTANTES DEL MODELO&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="1080" width="1450" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="nota1" value="✅ Usuario tiene 5 tipos diferentes (polimorfismo en un solo modelo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="1120" width="700" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="nota2" value="🔄 Informe tiene auto-referencia para versionado (informe_anterior_id)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="820" y="1120" width="730" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="nota3" value="📊 Informe tiene 11 estados posibles gestionados por State Machine Pattern" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="1160" width="700" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="nota4" value="🗂️ Solo 1 banco puede estar activo por docente (constraint lógico)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="820" y="1160" width="730" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="nota5" value="🔍 Todas las fechas son de auditoría para trazabilidad completa del flujo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="1200" width="700" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="nota6" value="📈 Índices compuestos optimizan queries por docente/presidente + estado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="820" y="1200" width="730" height="30" as="geometry"/>
